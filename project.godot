shoot={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":false,"double_click":false,"script":null)
]
}

[internationalization]

locale/translations=PackedStringArray("res://addons/maaacks_game_template/base/translations/menus_translations.en.translation", "res://addons/maaacks_game_template/base/translations/menus_translations.fr.translation")

[maaacks_game_template]

disable_install_audio_busses=true
disable_install_wizard=true
main_menu_scene_path="res://template_sample_assets/scenes/menus/main_menu/main_menu.tscn"
game_scene_path="res://template_sample_assets/scenes/game/game.tscn"
ending_scene_path="res://template_sample_assets/scenes/end_credits/end_credits.tscn"
loading_scene_path="res://template_sample_assets/scenes/loading_screen/loading_screen.tscn"
copy_path="res://template_sample_assets/"

[physics]

3d/physics_engine="Jolt Physics"

[plugin_updater]

plugins={
"res://addons/maaacks_game_template/": "https://github.com/Maaack/Godot-Game-Template",
"res://addons/plugin_updater/": "https://github.com/Maaack/Godot-Plugin-Updater"
}

[rendering]

rendering_device/driver.windows="d3d12"
